    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        prefs = getSharedPreferences("makoo_kids_languages", MODE_PRIVATE)
        updateStreakAndSession()
        tts = TextToSpeech(this, this)
        buildUi()
        refreshHeaderStats()
        showMode("Daily Practice")
        if (!prefs.getBoolean("welcome_seen", false)) {
            Toast.makeText(this, "Welcome to Makoo! Pick an age and language, then start with Daily Practice.", Toast.LENGTH_LONG).show()
            prefs.edit().putBoolean("welcome_seen", true).apply()
        }
    }

    private fun pack(
        name: String, nativeName: String, locale: Locale, hello: String, thanks: String,
        yes: String, no: String, child: String, mother: String, father: String, water: String,
        apple: String, book: String, school: String, one: String, two: String, three: String,
        how: String, reply: String, alphabet: String
    ) = LanguagePack(name, nativeName, locale, hello, thanks, yes, no, child, mother, father, water, apple, book, school, one, two, three, how, reply, alphabet)

    private fun buildUi() {
        window.statusBarColor = navy
        window.navigationBarColor = cream

        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(dp(14), dp(12), dp(14), dp(24))
            setBackgroundColor(cream)
        }
