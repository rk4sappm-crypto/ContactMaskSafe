                LearningItem("Water", p.water, "💧"),
                LearningItem("Apple", p.apple, "🍎")
            )
            1 -> listOf(
                LearningItem("Thank you", p.thanks, "🙏"),
                LearningItem("Book", p.book, "📘"),
                LearningItem("School", p.school, "🏫"),
                LearningItem("One", p.one, "1️⃣"),
                LearningItem("How are you?", p.how, "💬")
            )
            else -> listOf(
                LearningItem("Mother", p.mother, "👩"),
                LearningItem("Father", p.father, "👨"),
                LearningItem("Three", p.three, "3️⃣"),
                LearningItem("How are you?", p.how, "🗣️"),
                LearningItem("I am fine.", p.reply, "😊")
            )
        }
    }

    private fun allWordItems(p: LanguagePack): List<LearningItem> = listOf(
        LearningItem("Hello", p.hello, "👋"),
        LearningItem("Thank you", p.thanks, "🙏"),
        LearningItem("Yes", p.yes, "✅"),
        LearningItem("No", p.no, "❌"),
        LearningItem("Child", p.child, "🧒"),
        LearningItem("Mother", p.mother, "👩"),
        LearningItem("Father", p.father, "👨"),
        LearningItem("Water", p.water, "💧"),
        LearningItem("Apple", p.apple, "🍎"),
        LearningItem("Book", p.book, "📘"),
        LearningItem("School", p.school, "🏫"),
        LearningItem("One", p.one, "1️⃣"),
        LearningItem("Two", p.two, "2️⃣"),
        LearningItem("Three", p.three, "3️⃣")
    )

    private fun speakingItems(): List<LearningItem> {
        val p = currentPack()
        return allWordItems(p) + listOf(
            LearningItem("How are you?", p.how, "💬"),
            LearningItem("I am fine.", p.reply, "😊")
        )
    }

    private fun currentPack(): LanguagePack = packs[languageSpinner.selectedItemPosition.coerceIn(0, packs.lastIndex)]

    private fun setCurrentItem(item: LearningItem) {
        currentTarget = item.target
        currentEnglish = item.english
        currentEmoji = item.emoji
    }

    private fun speakText(text: String) {
        if (!ttsReady) {
            Toast.makeText(this, "Voice engine is getting ready. Try again in a moment.", Toast.LENGTH_SHORT).show()
            return
        }
        val result = tts.setLanguage(currentPack().locale)
        if (result == TextToSpeech.LANG_MISSING_DATA || result == TextToSpeech.LANG_NOT_SUPPORTED) {
            Toast.makeText(this, "The installed Android voice engine does not currently support ${currentPack().name}.", Toast.LENGTH_LONG).show()
            return
        }
        tts.setSpeechRate(speechRate())
        tts.speak(text, TextToSpeech.QUEUE_FLUSH, null, "makoo_target")
    }

    private fun speakQueue(lines: List<String>) {
        if (!ttsReady) return
        val result = tts.setLanguage(currentPack().locale)
        if (result < TextToSpeech.LANG_AVAILABLE) {
            Toast.makeText(this, "Voice data is unavailable for ${currentPack().name} on this device.", Toast.LENGTH_LONG).show()
            return
        }
        tts.setSpeechRate(speechRate())
        tts.stop()
        lines.forEachIndexed { index, line ->
            tts.speak(line, if (index == 0) TextToSpeech.QUEUE_FLUSH else TextToSpeech.QUEUE_ADD, null, "makoo_$index")
        }
    }

    private fun playItems(items: List<LearningItem>) = speakQueue(items.map { it.target })

    private fun speechRate(): Float = when (speedSpinner.selectedItemPosition.coerceAtLeast(0)) {
        1 -> 0.90f
        2 -> 1.05f
        else -> 0.72f
    }

    override fun onInit(status: Int) {
        ttsReady = status == TextToSpeech.SUCCESS
    }

    private fun startListening() {
        if (checkSelfPermission(Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
            requestPermissions(arrayOf(Manifest.permission.RECORD_AUDIO), 44)
            return
        }
        if (!SpeechRecognizer.isRecognitionAvailable(this)) {
            Toast.makeText(this, "Speech recognition is not available on this device.", Toast.LENGTH_LONG).show()
            return
        }
        speech?.destroy()
        speech = SpeechRecognizer.createSpeechRecognizer(this)
        Toast.makeText(this, "Say: $currentTarget", Toast.LENGTH_LONG).show()
        speech?.setRecognitionListener(object : RecognitionListener {
            override fun onReadyForSpeech(params: Bundle?) {}
            override fun onBeginningOfSpeech() {}
            override fun onRmsChanged(rmsdB: Float) {}
            override fun onBufferReceived(buffer: ByteArray?) {}
            override fun onEndOfSpeech() {}
            override fun onPartialResults(partialResults: Bundle?) {}
            override fun onEvent(eventType: Int, params: Bundle?) {}

            override fun onError(error: Int) {
                incrementAttempts()
                addMiss(LearningItem(currentEnglish, currentTarget, currentEmoji))
                Toast.makeText(this@MainActivity, "I couldn't hear that clearly. Try once more.", Toast.LENGTH_SHORT).show()
                refreshHeaderStats()
            }

            override fun onResults(results: Bundle?) {
                val heard = results?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)?.firstOrNull().orEmpty()
                val score = similarity(normalize(heard), normalize(currentTarget))
                incrementAttempts()
                val item = LearningItem(currentEnglish, currentTarget, currentEmoji)
                when {
                    score >= 0.85 -> {
                        addStars(3); incrementCorrect(); markDailySuccess()
                        Toast.makeText(this@MainActivity, "Excellent! ${(score * 100).toInt()}% • +3 stars 🌟", Toast.LENGTH_LONG).show()
                    }
                    score >= 0.70 -> {
                        addStars(2); incrementCorrect(); markDailySuccess()
                        Toast.makeText(this@MainActivity, "Great job! ${(score * 100).toInt()}% • +2 stars 🎉", Toast.LENGTH_LONG).show()
                    }
                    score >= 0.55 -> {
                        addStars(1); addMiss(item)
                        Toast.makeText(this@MainActivity, "Good try: ${(score * 100).toInt()}% • +1 star. Try again!", Toast.LENGTH_LONG).show()
                    }
                    else -> {
                        addMiss(item)
                        Toast.makeText(this@MainActivity, "You said: $heard\nScore: ${(score * 100).toInt()}%. Listen once more and retry.", Toast.LENGTH_LONG).show()
                    }
                }
                refreshHeaderStats()
            }
        })
        speech?.startListening(Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
            putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
            putExtra(RecognizerIntent.EXTRA_LANGUAGE, currentPack().locale.toLanguageTag())
            putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 3)
            putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, false)
            putExtra(RecognizerIntent.EXTRA_PROMPT, "Say: $currentTarget")
        })
    }

    private fun toggleFavorite(item: LearningItem) {
        val set = prefs.getStringSet("favorites", emptySet())?.toMutableSet() ?: mutableSetOf()
        val code = favoriteCode(currentPack().name, item)
        if (!set.add(code)) set.remove(code)
        prefs.edit().putStringSet("favorites", set).apply()
    }

    private fun isFavorite(item: LearningItem): Boolean {
        return prefs.getStringSet("favorites", emptySet())?.contains(favoriteCode(currentPack().name, item)) == true
    }

    private fun favoriteCode(language: String, item: LearningItem) = listOf(language, item.english, item.target, item.emoji).joinToString("\u001F")

    private fun getFavoriteItems(language: String): List<LearningItem> {
        return (prefs.getStringSet("favorites", emptySet()) ?: emptySet()).mapNotNull { raw ->
            val p = raw.split("\u001F")
            if (p.size == 4 && p[0] == language) LearningItem(p[1], p[2], p[3]) else null
        }.sortedBy { it.english }
    }

    private fun missKey(item: LearningItem): String = "miss_${currentPack().name}_${item.english}".replace(Regex("[^A-Za-z0-9_]+"), "_")
    private fun addMiss(item: LearningItem) { prefs.edit().putInt(missKey(item), missCount(item) + 1).apply() }
    private fun missCount(item: LearningItem) = prefs.getInt(missKey(item), 0)

    private fun addStars(amount: Int) { prefs.edit().putInt("stars", prefs.getInt("stars", 0) + amount).apply() }
    private fun incrementAttempts() { prefs.edit().putInt("attempts", prefs.getInt("attempts", 0) + 1).apply() }
    private fun incrementCorrect() { prefs.edit().putInt("correct", prefs.getInt("correct", 0) + 1).apply() }

    private fun markDailySuccess() {
        val key = "daily_${todayKey()}"
        prefs.edit().putInt(key, prefs.getInt(key, 0) + 1).apply()
    }

    private fun dailyDone() = prefs.getInt("daily_${todayKey()}", 0)
    private fun dailyGoal() = when (goalSpinner.selectedItemPosition.coerceAtLeast(0)) { 0 -> 5; 2 -> 15; else -> 10 }

    private fun refreshHeaderStats() {
        if (!::statsText.isInitialized) return
        val stars = prefs.getInt("stars", 0)
        val streak = prefs.getInt("streak", 1)
        val sessions = prefs.getInt("sessions", 1)
        statsText.text = "⭐ $stars stars    🔥 $streak-day streak    📚 $sessions sessions"
        val done = dailyDone()
        val goal = dailyGoal()
        dailyProgress.max = goal
        dailyProgress.progress = done.coerceAtMost(goal)
        dailyText.text = if (done >= goal) "🎉 Daily goal complete! $done / $goal" else "Today's practice: $done / $goal"
    }

    private fun updateStreakAndSession() {
        val today = todayKey()
        val last = prefs.getString("last_open", null)
        var streak = prefs.getInt("streak", 0)
        if (last == null) streak = 1
        else if (last != today) streak = if (isYesterday(last)) max(1, streak + 1) else 1
        val sessions = prefs.getInt("sessions", 0) + 1
        prefs.edit().putString("last_open", today).putInt("streak", streak).putInt("sessions", sessions).apply()
    }

    private fun todayKey(): String = SimpleDateFormat("yyyyMMdd", Locale.US).format(Date())

    private fun isYesterday(dateKey: String): Boolean {
        return try {
            val fmt = SimpleDateFormat("yyyyMMdd", Locale.US).apply { isLenient = false }
            val d = fmt.parse(dateKey) ?: return false
            val cal = Calendar.getInstance().apply { time = Date(); add(Calendar.DAY_OF_YEAR, -1) }
            fmt.format(cal.time) == fmt.format(d)
        } catch (_: Exception) { false }
    }

    private fun badgeFor(stars: Int): String = when {
        stars >= 300 -> "🏆 Language Champion"
        stars >= 150 -> "🥇 Super Speaker"
        stars >= 75 -> "🥈 Brave Explorer"
        stars >= 30 -> "🥉 Rising Star"
        else -> "🌱 New Learner"
    }

    private fun normalize(s: String) = s.lowercase(Locale.ROOT).replace(Regex("[^\\p{L}\\p{N}]+"), "").trim()

    private fun similarity(a: String, b: String): Double {
        if (a == b && a.isNotEmpty()) return 1.0
        if (a.isEmpty() || b.isEmpty()) return 0.0
        val prev = IntArray(b.length + 1) { it }
        val cur = IntArray(b.length + 1)
        for (i in 1..a.length) {
            cur[0] = i
            for (j in 1..b.length) {
                cur[j] = minOf(cur[j - 1] + 1, prev[j] + 1, prev[j - 1] + if (a[i - 1] == b[j - 1]) 0 else 1)
            }
            for (j in prev.indices) prev[j] = cur[j]
        }
        return 1.0 - prev[b.length].toDouble() / max(a.length, b.length)
    }

    private fun spinner(items: Array<String>): Spinner = Spinner(this).apply {
        adapter = ArrayAdapter(this@MainActivity, android.R.layout.simple_spinner_dropdown_item, items)
        background = rounded(Color.WHITE, 12, Color.rgb(215, 220, 228))
        setPadding(dp(10), 0, dp(8), 0)
    }

    private fun listener(block: (Int) -> Unit) = object : AdapterView.OnItemSelectedListener {
        override fun onItemSelected(parent: AdapterView<*>?, view: View?, position: Int, id: Long) = block(position)
        override fun onNothingSelected(parent: AdapterView<*>?) {}
    }

    private fun label(textValue: String) = TextView(this).apply {
        text = textValue
        textSize = 14f
        setTextColor(navy)
        setTypeface(typeface, Typeface.BOLD)
        setPadding(dp(2), dp(2), dp(2), dp(4))
    }

    private fun infoText(textValue: String) = TextView(this).apply {
        text = textValue
        textSize = 13.5f
        setTextColor(muted)
        setPadding(dp(5), 0, dp(5), dp(3))
    }

    private fun emptyState(icon: String, title: String, body: String): View = card(Color.WHITE, 22).apply {
        orientation = LinearLayout.VERTICAL
        gravity = Gravity.CENTER
