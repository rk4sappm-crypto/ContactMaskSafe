+            "Quiz", "Story Practice", "Flashcards", "Numbers & Counting", "Listening Challenge", "Smart Review"
+        )
+        val chosen = choices.random()
+        Toast.makeText(this, "🎲 Surprise adventure: $chosen", Toast.LENGTH_SHORT).show()
+        showMode(chosen, navigate = true)
     }
 
