+    private fun updateAdventureSelection() {
+        adventureCards.forEach { (name, views) ->
+            val selected = name == currentMode
+            val baseColor = if ((adventureCards.keys.indexOf(name)) % 2 == 0) paleBlue else paleOrange
+            views.card.background = if (selected) rounded(navy, 18, orange) else rounded(baseColor, 18, Color.rgb(225, 229, 236))
+            views.card.elevation = dp(if (selected) 7 else 2).toFloat()
+            views.title.setTypeface(views.title.typeface, if (selected) Typeface.BOLD else Typeface.NORMAL)
+            views.title.textSize = if (selected) 15.5f else 14.5f
+            views.title.setTextColor(if (selected) Color.WHITE else navy)
+            views.subtitle.setTextColor(if (selected) Color.rgb(225, 238, 255) else muted)
+            views.icon.textSize = if (selected) 28f else 25f
+            views.card.alpha = if (selected) 1f else 0.96f
+        }
+    }
+
+    private fun scrollToSelectedContent() {
+        if (!::mainScroll.isInitialized || !::modeTitle.isInitialized) return
+        mainScroll.postDelayed({
+            mainScroll.smoothScrollTo(0, (modeTitle.top - dp(8)).coerceAtLeast(0))
+            modeTitle.requestFocus()
+        }, 80)
+    }
+
+    private fun scrollToAdventures() {
+        if (!::mainScroll.isInitialized || !::adventureHeading.isInitialized) return
+        mainScroll.post { mainScroll.smoothScrollTo(0, (adventureHeading.top - dp(8)).coerceAtLeast(0)) }
+    }
+
+    private fun launchSurpriseAdventure() {
