+    private fun deckIndexKey(): String = "deck_index_${currentPack().name}_${currentMode}".replace(Regex("[^A-Za-z0-9_]+"), "_")
+
+    private fun saveDeckIndex() {
+        prefs.edit().putInt(deckIndexKey(), activeIndex).apply()
+    }
