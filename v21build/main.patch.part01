+    private fun showListeningChallenge() {
+        contentArea.addView(infoText("Listen without seeing the answer, then choose the English meaning. Correct answers earn stars."))
+        contentArea.addView(spacer(7))
+        renderListeningChallenge()
+    }
+
+    private fun renderListeningChallenge() {
+        while (contentArea.childCount > 2) contentArea.removeViewAt(2)
+        val pool = allWordItems(currentPack())
+        val question = pool.random()
+        setCurrentItem(question)
+        val options = (pool.filter { it.english != question.english }.shuffled().take(3) + question).shuffled()
+        val c = card(Color.rgb(242, 249, 255), 22).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(15), dp(15), dp(15), dp(15))
+        }
+        c.addView(TextView(this).apply {
+            text = "🎧 What did you hear?"
+            textSize = 22f
+            setTextColor(navy)
+            setTypeface(typeface, Typeface.BOLD)
+            gravity = Gravity.CENTER
+        })
+        c.addView(TextView(this).apply {
+            text = "Tap the speaker, then choose the meaning."
+            textSize = 13f
+            setTextColor(muted)
+            gravity = Gravity.CENTER
+            setPadding(0, dp(4), 0, dp(8))
+        })
+        c.addView(actionButton("🔊 Hear the word", navy) { speakText(question.target) }, fullButton())
+        options.forEach { option ->
+            c.addView(actionButton("${option.emoji}  ${option.english}", Color.rgb(72, 98, 145)) {
+                incrementAttempts()
+                if (option.english == question.english) {
+                    addStars(2)
+                    incrementCorrect()
+                    markDailySuccess()
+                    Toast.makeText(this@MainActivity, "Correct! It was ${question.target} • +2 stars 🎉", Toast.LENGTH_SHORT).show()
+                } else {
+                    addMiss(question)
+                    Toast.makeText(this@MainActivity, "Good try. ${question.target} means ${question.english}.", Toast.LENGTH_LONG).show()
+                }
+                refreshHeaderStats()
+                renderListeningChallenge()
+            }, fullButton())
+        }
+        contentArea.addView(c)
+        c.postDelayed({ speakText(question.target) }, 250)
+    }
+
+    private fun showAchievements() {
+        val stars = prefs.getInt("stars", 0)
+        val milestones = listOf(
+            Triple(30, "🥉 Rising Star", "Complete regular listening and speaking practice"),
+            Triple(75, "🥈 Brave Explorer", "Keep exploring different adventures"),
+            Triple(150, "🥇 Super Speaker", "Build strong pronunciation confidence"),
+            Triple(300, "🏆 Language Champion", "Reach the top Makoo badge")
+        )
+        contentArea.addView(infoText("Badges unlock automatically as stars grow. Try different adventures to make learning balanced."))
+        contentArea.addView(spacer(7))
+        val c = card(Color.WHITE, 22).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(15), dp(15), dp(15), dp(15))
+        }
+        c.addView(TextView(this).apply {
+            text = "🏅 My Achievements\n⭐ $stars stars"
+            textSize = 23f
+            setTextColor(navy)
+            setTypeface(typeface, Typeface.BOLD)
+            gravity = Gravity.CENTER
+            setPadding(0, 0, 0, dp(10))
+        })
+        milestones.forEach { (need, title, desc) ->
+            val unlocked = stars >= need
+            c.addView(card(if (unlocked) Color.rgb(235, 251, 241) else Color.rgb(247, 248, 250), 16).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(dp(12), dp(10), dp(12), dp(10))
+                addView(TextView(this@MainActivity).apply {
+                    text = if (unlocked) "✅ $title" else "🔒 $title • $need stars"
+                    textSize = 16f
+                    setTextColor(if (unlocked) green else muted)
+                    setTypeface(typeface, Typeface.BOLD)
+                })
+                addView(TextView(this@MainActivity).apply {
+                    text = if (unlocked) "Unlocked! $desc" else "$desc • ${need - stars} more stars to unlock"
+                    textSize = 12.5f
+                    setTextColor(muted)
+                    setPadding(0, dp(3), 0, 0)
+                })
+            }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply { setMargins(0, dp(4), 0, dp(4)) })
+        }
+        val next = milestones.firstOrNull { stars < it.first }
+        if (next != null) c.addView(actionButton("🎯 Practice for next badge", orange) { showMode("Daily Practice", navigate = true) }, fullButton())
+        else c.addView(actionButton("🎲 Try a surprise adventure", Color.rgb(103, 72, 170)) { launchSurpriseAdventure() }, fullButton())
+        contentArea.addView(c)
+    }
